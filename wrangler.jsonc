{
  // outatime-88: static assets under mutaafaziz.com/outatime/ plus the leaderboard API.
  // The route takes precedence over the mutaafaziz.com Custom Domain (the personal site).
  // Operator-owned file (agents/control.json → frozen_paths).
  "name": "outatime-88",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // No previews. Cloudflare never serves preview URLs for Workers with Durable Objects, yet
  // every PR preview still created its own copy of each DO namespace: 97 leaked copies hit the
  // Free-plan cap of 100 on 2026-10-22 and blocked new deploys account-wide (cleaned up by hand).
  "preview_urls": false,
  // The Worker script only runs for /outatime/api/* (the leaderboard, src/worker/).
  // Everything else is served straight from static assets with dist/_headers applied.
  "main": "src/worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/outatime/api/*"] },
  // No database_id on purpose: `wrangler deploy` (Workers Builds) provisions this D1 database
  // by name on first deploy and finds it by name after. The Worker creates its own tables.
  "d1_databases": [{ "binding": "DB", "database_name": "outatime-88-leaderboard" }],
  // Live races (sprint 3): one RaceRoom per 4-letter code, one global MatchIndex for quick
  // races. SQLite-backed classes are the kind the Workers Free plan supports. Note: Cloudflare
  // does not generate version (PR preview) URLs for Workers that implement Durable Objects.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RaceRoom" },
      { "name": "MATCH", "class_name": "MatchIndex" },
      // TV mode (ticket 0175): one PadRoom per pairing code (TV screen + phone pads).
      { "name": "PADS", "class_name": "PadRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaceRoom", "MatchIndex"] },
    { "tag": "v2", "new_sqlite_classes": ["PadRoom"] }
  ],
  "routes": [{ "pattern": "mutaafaziz.com/outatime*", "zone_name": "mutaafaziz.com" }]
}
